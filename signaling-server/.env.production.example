# Production environment variables for zapit-signaling.
# On Koyeb: add these in Service → Environment Variables.
# NEVER commit a file with real values — use this as the template.

# ── Runtime ───────────────────────────────────────────────────────────────────

# Set to "production" to enable startup guards and structured JSON logging.
# Koyeb sets this automatically; set it manually if running with Docker/PM2.
NODE_ENV=production

# Port the HTTP/WebSocket server listens on. Koyeb routes 443 → this port.
PORT=8787

# ── TURN relay (Metered.ca — free tier, no credit card) ──────────────────────

# Your Metered.ca API key — found in the Metered dashboard after signup.
# Sign up free at: https://www.metered.ca/tools/openrelay/
# If not set, TURN relay is disabled and users on restricted networks may not
# be able to connect (P2P still works for most networks).
METERED_API_KEY=your_metered_api_key_here

# Your Metered.ca subdomain host — shown in the Metered dashboard.
# Example: zapit.metered.ca
METERED_API_HOST=yourapp.metered.ca

# ── CORS / Origin enforcement ─────────────────────────────────────────────────

# Comma-separated list of allowed WebSocket origins. Only these origins may
# connect. Set to your Vercel deployment URL. REQUIRED in production.
# Example: https://zapit.vercel.app,https://zapit.io
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# ── Observability ─────────────────────────────────────────────────────────────

# Pino log level. Use "info" in production.
LOG_LEVEL=info
