# Copy this file to .env (which is gitignored) and fill in real values.
# NEVER commit .env — it contains secrets.
PORT=8787

# TURN relay credentials (Metered.ca hosted service — see turn-credentials.ts).
# Optional for local dev: without these, TURN is disabled and the app falls
# back to STUN-only, which is fine on most LANs. Sign up free at metered.ca.
METERED_API_KEY=
METERED_API_HOST=

LOG_LEVEL=info
# Comma-separated list of allowed WebSocket origins (e.g. https://zapit.io).
# Leave empty to skip origin enforcement (development only).
ALLOWED_ORIGINS=https://zapit.io
# Comma-separated IPs of trusted reverse proxies that may set x-forwarded-for.
TRUSTED_PROXIES=
