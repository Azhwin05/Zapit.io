# Copy this file to .env (which is gitignored) and fill in real values.
# NEVER commit .env — it contains secrets.
PORT=8787
TURN_SECRET=change_me_to_a_long_random_string_at_least_32_chars
TURN_HOST=turn.yourdomain.com
LOG_LEVEL=info
# Comma-separated list of allowed WebSocket origins (e.g. https://zapit.io).
# Leave empty to skip origin enforcement (development only).
ALLOWED_ORIGINS=https://zapit.io
# Comma-separated IPs of trusted reverse proxies that may set x-forwarded-for.
TRUSTED_PROXIES=
