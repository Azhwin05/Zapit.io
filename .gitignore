# ── Secrets ───────────────────────────────────────────────────────────────────
# Never commit real .env files — use .env.example as the committed template.
.env
.env.local
.env.production
.env.staging

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
.next/
dist/
out/

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# ── TypeScript incremental cache ──────────────────────────────────────────────
*.tsbuildinfo

# ── Test artifacts ────────────────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/
coverage/

# ── Desktop app build artifacts ───────────────────────────────────────────────
# desktop/resources/ is generated by desktop/scripts/prepare-resources.mjs
# (a full copy of frontend + signaling-server with production node_modules —
# large, and fully reproducible from source, so it doesn't belong in git).
desktop/resources/
