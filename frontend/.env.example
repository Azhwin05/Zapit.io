# Copy this file to .env.local (which is gitignored) to override defaults.
# Everything here is optional — the app runs with sensible defaults if unset.

# WebSocket URL of the signaling server the app connects to.
#   - Local dev:   ws://localhost:8787  (the default if this is unset)
#   - Self-hosted: ws://<your-lan-ip>:8787  or  wss://<your-domain>
#   - Vercel:      set this to your deployed signaling server's wss:// URL
#
# NEXT_PUBLIC_ is baked in at build time. For runtime switching (e.g. LAN
# mode), users can instead set a custom URL in-app via the settings panel,
# which overrides this value — see lib/signaling-url.ts.
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8787
