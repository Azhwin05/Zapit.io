# Production environment variables for the Zapit Next.js frontend.
# On Vercel: add these in Project → Settings → Environment Variables (Production only).
# NEVER commit a file containing real values.

# ── Signaling server ──────────────────────────────────────────────────────────

# WebSocket URL of the deployed signaling server.
# Must be wss:// (TLS) in production — a plain ws:// URL will be blocked by browsers
# on HTTPS pages and by the production Content-Security-Policy.
# After deploying the signaling server to Koyeb, this will be
# wss://<your-koyeb-app>.koyeb.app
NEXT_PUBLIC_SIGNALING_URL=wss://your-koyeb-app.koyeb.app

# ── Notes ─────────────────────────────────────────────────────────────────────
# NODE_ENV is set automatically by Vercel to "production" for production deployments.
# No additional variables are required — the app has no server-side secrets.
# The signaling server URL is the only public config value needed at build time.
